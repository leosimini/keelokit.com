---
import '../styles/global.css';
import { AUTHOR, REPO, T, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = T[locale];
const site = 'https://keelokit.com';
const canonical = locale === 'en' ? `${site}/` : `${site}/es`;

// The author's canonical identity lives on his own site; this page only points to it.
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    '@id': REPO,
    name: 'Keelokit',
    description: t.description,
    url: canonical,
    sameAs: [`${AUTHOR.url}/keelokit`],
    codeRepository: REPO,
    programmingLanguage: ['TypeScript', 'Python'],
    runtimePlatform: 'Claude Code',
    license: 'https://opensource.org/licenses/MIT',
    inLanguage: locale,
    author: { '@id': `${AUTHOR.url}/#person` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${AUTHOR.url}/#person`,
    name: AUTHOR.name,
    alternateName: ['Leo Simini', AUTHOR.handle],
    url: AUTHOR.url,
    sameAs: AUTHOR.sameAs,
  },
];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta name="author" content={AUTHOR.name} />
    <link rel="author" href={AUTHOR.url} />
    <link rel="me" href={AUTHOR.url} />
    <link rel="me" href={AUTHOR.github} />
    <link rel="me" href={AUTHOR.linkedin} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={`${site}/`} />
    <link rel="alternate" hreflang="es" href={`${site}/es`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/`} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f6f1e8" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Keelokit" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogAlt} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'es_AR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.title} />
    <meta name="twitter:description" content={t.description} />
    <meta name="twitter:image" content={`${site}/og.png`} />
    <meta name="twitter:image:alt" content={t.ogAlt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Fragment+Mono&family=Karla:wght@400;500;600&display=swap" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  </head>
  <body>
    <a class="skip" href="#main">{locale === 'en' ? 'Skip to content' : 'Ir al contenido'}</a>
    <slot />
    <script>
      import { fetchReleaseCached, releaseDate, releaseNotes, releaseZip } from '../lib/release';
      // Copy buttons: the label says "Copied" for a moment, and screen readers hear it.
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const text = btn.dataset.copy ?? '';
          try { await navigator.clipboard.writeText(text); } catch { return; }
          const label = btn.querySelector('span')!;
          const idle = btn.dataset.idle!;
          label.textContent = btn.dataset.done!;
          btn.classList.add('is-done');
          setTimeout(() => { label.textContent = idle; btn.classList.remove('is-done'); }, 1600);
        });
      });
      // The release line: the build wrote the version it saw; this refreshes it from the release
      // branch, so a new Keelokit version shows up without redeploying the site. Cached for an
      // hour, so it doesn't ask GitHub again on every page.
      const line = document.querySelector<HTMLElement>('[data-release]');
      if (line) {
        fetchReleaseCached().then((r) => {
          if (!r) return;
          line.querySelector('[data-release-version]')!.textContent = `v${r.version}`;
          line.querySelector('[data-release-date]')!.textContent = r.date ? ` · ${releaseDate(r.date, line.dataset.lang!)}` : '';
          line.querySelectorAll<HTMLAnchorElement>('[data-release-notes]').forEach((a) => { a.href = releaseNotes(r.version); });
          document.querySelectorAll<HTMLAnchorElement>('[data-release-zip]').forEach((a) => { a.href = releaseZip(r.version); });
          line.hidden = false;
        });
      }
      // The bar: compact once the page moves, deep glass once the sky is behind it.
      const bar = document.querySelector<HTMLElement>('[data-bar]');
      const hero = document.querySelector<HTMLElement>('.hero');
      const toTop = document.querySelector<HTMLElement>('[data-to-top]');
      const onScroll = () => {
        const y = window.scrollY;
        bar?.classList.toggle('is-stuck', y > 8);
        bar?.classList.toggle('is-deep', !!hero && hero.getBoundingClientRect().bottom < (bar?.offsetHeight ?? 60));
        if (toTop) toTop.hidden = y < document.documentElement.scrollHeight / 2 - innerHeight / 2;
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      // Where you are: the section under the bar is marked in the nav and in the menu.
      const spied = [...new Set([...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')].map((a) => a.dataset.spy!))]
        .map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
      let ticking = false;
      const mark = () => {
        ticking = false;
        const current = spied.filter((el) => el.getBoundingClientRect().top < innerHeight * 0.4).pop();
        const id = current && current.getBoundingClientRect().bottom > 0 ? current.id : undefined;
        document.querySelectorAll<HTMLAnchorElement>('[data-spy]').forEach((a) => {
          if (a.dataset.spy === id) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
        });
      };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(mark); } }, { passive: true });
      mark();
      // The menu (mobile): a sheet with the sections; Esc, the close button or a link close it.
      const sheet = document.querySelector<HTMLElement>('[data-menu]');
      const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]');
      if (sheet && opener) {
        const focusables = () => [...sheet.querySelectorAll<HTMLElement>('a, button')];
        const close = (refocus = true) => {
          sheet.hidden = true;
          opener.setAttribute('aria-expanded', 'false');
          document.documentElement.classList.remove('menu-open');
          if (refocus) opener.focus();
        };
        opener.addEventListener('click', () => {
          sheet.hidden = false;
          opener.setAttribute('aria-expanded', 'true');
          document.documentElement.classList.add('menu-open');
          focusables()[1]?.focus();
        });
        sheet.querySelector('[data-menu-close]')?.addEventListener('click', () => close());
        sheet.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => close(false)));
        sheet.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') { close(); return; }
          if (e.key !== 'Tab') return;
          const f = focusables(); const first = f[0]; const last = f[f.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        });
        matchMedia('(min-width: 901px)').addEventListener('change', (m) => { if (m.matches && !sheet.hidden) close(false); });
      }
      // Sections rise into view once; nothing moves for people who ask for less motion.
      const els = document.querySelectorAll('.rise');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }), { rootMargin: '0px 0px -10% 0px' });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
