---
// Flat icons of the roles that have no isometric picture: the wheel, the seal, the narrow channel,
// the crew and the owner's signature. Their paint is the brand tokens, so they follow the theme.
interface Props { name: 'wheel' | 'seal' | 'channel' | 'crew' | 'approve'; label: string }
const { name, label } = Astro.props;
const angles = [0, 45, 90, 135, 180, 225, 270, 315];
const box = name === 'crew' ? '0 0 120 74' : '0 0 74 74';
---
<svg class="icon" viewBox={box} role="img" aria-label={label} focusable="false">
  {name === 'wheel' && (<>
    <g fill="none" style="stroke:var(--board)" stroke-width="4" stroke-linecap="round">
      <circle cx="37" cy="37" r="21" /><circle cx="37" cy="37" r="6" stroke-width="3" />
      {angles.map((a) => <path d="M37 16 V4" transform={`rotate(${a} 37 37)`} />)}
    </g>
    <circle cx="37" cy="37" r="3" style="fill:var(--foil)" />
  </>)}
  {name === 'seal' && (<>
    <polygon points="67.0,37.0 62.1,43.7 63.0,52.0 55.4,55.4 52.0,63.0 43.7,62.1 37.0,67.0 30.3,62.1 22.0,63.0 18.6,55.4 11.0,52.0 11.9,43.7 7.0,37.0 11.9,30.3 11.0,22.0 18.6,18.6 22.0,11.0 30.3,11.9 37.0,7.0 43.7,11.9 52.0,11.0 55.4,18.6 63.0,22.0 62.1,30.3" style="fill:var(--foil)" />
    <circle cx="37" cy="37" r="19" fill="none" style="stroke:var(--foam)" stroke-opacity=".7" stroke-width="2" />
    <path d="M27 38 l7 7 l14 -16" fill="none" style="stroke:var(--foam)" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
  </>)}
  {name === 'channel' && (<>
    <rect x="2" y="6" width="26" height="62" rx="3" fill="#cdc4ae" /><rect x="46" y="6" width="26" height="62" rx="3" fill="#cdc4ae" />
    <rect x="28" y="6" width="18" height="62" fill="#2479c6" />
    <path d="M37 18 l8 8 v18 l-8 6 l-8 -6 v-18 z" style="fill:var(--foam)" />
    <path d="M37 18 l8 8 h-16 z" style="fill:var(--foil)" />
    <path d="M33 60 h8" stroke="#dff3ff" stroke-width="2" stroke-linecap="round" stroke-opacity=".6" />
  </>)}
  {name === 'crew' && (<>
    <g style="fill:var(--foam)"><circle cx="19" cy="26" r="9" /><path d="M4 62 v-12 a15 15 0 0 1 30 0 v12 z" /></g>
    <g style="fill:var(--foam)"><circle cx="59" cy="26" r="9" /><path d="M44 62 v-12 a15 15 0 0 1 30 0 v12 z" /></g>
    <g fill="none" style="stroke:var(--foam)" stroke-opacity=".6" stroke-width="2" stroke-dasharray="4 4"><circle cx="105" cy="26" r="9" /><path d="M90 62 v-12 a15 15 0 0 1 30 0 v12 z" /></g>
  </>)}
  {name === 'approve' && (<>
    <circle cx="37" cy="37" r="30" fill="none" style="stroke:var(--foam)" stroke-opacity=".8" stroke-width="3" />
    <path d="M22 38 l11 11 l20 -23" fill="none" style="stroke:var(--reef)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
  </>)}
</svg>
