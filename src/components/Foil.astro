---
// The hero scene: the Keelokit hydrofoil on a wide sea. The sea's last colour is the page's
// first underwater colour (--sea-0), so the hero flows into the rest of the page.
---
<svg class="foil-scene" viewBox="0 0 1600 560" preserveAspectRatio="xMaxYMax slice" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="sea" x1="0" y1="360" x2="0" y2="560" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#3f9ce6"/>
      <stop offset="0.35" stop-color="#2479c6"/>
      <stop offset="1" stop-color="#1a64b0"/>
    </linearGradient>
    <linearGradient id="shine" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#bfe6ff" stop-opacity="0.55"/>
      <stop offset="1" stop-color="#bfe6ff" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="board" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffe45a"/><stop offset="0.55" stop-color="#fbc82a"/><stop offset="1" stop-color="#e9a415"/>
    </linearGradient>
    <linearGradient id="mast" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#f7963a"/><stop offset="0.6" stop-color="#ee7b24"/><stop offset="1" stop-color="#d8621a"/>
    </linearGradient>
    <linearGradient id="wing" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffa24a"/><stop offset="1" stop-color="#d9651c"/>
    </linearGradient>
    <clipPath id="under">
      <path d="M0 372 C180 364 300 330 430 330 C560 330 640 360 760 368 C900 378 1020 380 1160 372 C1300 364 1420 356 1600 362 V560 H0 Z"/>
    </clipPath>
  </defs>

  <!-- the sea -->
  <path d="M0 372 C180 364 300 330 430 330 C560 330 640 360 760 368 C900 378 1020 380 1160 372 C1300 364 1420 356 1600 362 V560 H0 Z" fill="url(#sea)"/>
  <path d="M0 372 C180 364 300 330 430 330 C560 330 640 360 760 368 C900 378 1020 380 1160 372 C1300 364 1420 356 1600 362 V396 C1420 390 1300 398 1160 406 C1020 414 900 412 760 402 C640 394 560 364 430 364 C300 364 180 398 0 406 Z" fill="url(#shine)"/>
  <g class="swell">
    <path d="M40 430 H560 M720 446 H1500 M120 492 H760 M900 506 H1560" stroke="#dff3ff" stroke-opacity="0.22" stroke-width="2" stroke-linecap="round"/>
  </g>
  <path d="M0 372 C180 364 300 330 430 330 C560 330 640 360 760 368 C900 378 1020 380 1160 372 C1300 364 1420 356 1600 362" fill="none" stroke="#f6f1e8" stroke-width="3" stroke-linecap="round"/>
  <path d="M360 342 C400 334 450 332 496 338" fill="none" stroke="#f6f1e8" stroke-width="2.4" stroke-linecap="round" opacity="0.8"/>
  <!-- wake -->
  <path d="M1148 382 C1040 388 930 390 790 386" fill="none" stroke="#f6f1e8" stroke-width="2.2" stroke-linecap="round" opacity="0.75"/>
  <path d="M1142 391 C1050 399 960 404 850 404" fill="none" stroke="#f6f1e8" stroke-width="1.6" stroke-linecap="round" opacity="0.5"/>

  <g class="bob">
    <!-- the foil (same shapes as the Keelokit icon) -->
    <g transform="translate(812 32) scale(1.25)">
      <path d="M104 356 C120 348 164 347 192 358 C168 367 126 368 104 361 Z" fill="url(#wing)"/>
      <path d="M130 361 C172 364 250 369 338 379 L338 388 C250 382 170 374 130 368 Z" fill="#e36e1e"/>
      <path d="M276 378 C310 364 386 366 436 390 C394 406 316 406 276 388 Z" fill="url(#wing)"/>
      <path d="M278 176 L302 176 C296 222 283 288 270 336 C264 358 262 368 268 380 L220 380 C236 373 245 362 249 344 C262 288 272 222 278 176 Z" fill="url(#mast)"/>
    </g>
    <!-- water over what's under the surface -->
    <g clip-path="url(#under)"><rect y="330" width="1600" height="230" fill="#1a64b0" opacity="0.18"/></g>
    <!-- the board and its mounting plate -->
    <g transform="translate(812 32) scale(1.25)">
      <path d="M102 208 C100 192 124 180 174 168 L374 122 C406 114 428 102 440 90 C450 116 444 140 420 152 C360 180 262 200 156 222 C122 228 104 224 102 208 Z" fill="url(#board)"/>
      <path d="M114 196 C150 182 250 160 378 132 C404 126 424 114 437 100" fill="none" stroke="#fff3a6" stroke-width="3" stroke-linecap="round" opacity="0.85"/>
      <path d="M146 214 C250 194 350 172 420 146" fill="none" stroke="#d98e10" stroke-width="3" stroke-linecap="round" opacity="0.55"/>
      <path d="M268 193 L312 185 L314 192 L270 201 Z" fill="#b8581a"/>
    </g>
  </g>
  <!-- spray where the mast cuts the surface -->
  <g class="spray" fill="#f6f1e8">
    <circle cx="1154" cy="362" r="4.5"/><circle cx="1138" cy="350" r="3"/><circle cx="1182" cy="356" r="3.4"/>
  </g>
  <path d="M1128 378 C1146 372 1176 372 1196 378" fill="none" stroke="#f6f1e8" stroke-width="3" stroke-linecap="round"/>
</svg>
